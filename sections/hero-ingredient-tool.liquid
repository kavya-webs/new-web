  }

  .hero-tool-section .hero-tool-ing-amount {
    font-size: 0.78rem !important;
    color: #71cbff !important;
    background: rgba(113, 203, 255, 0.12) !important;
    border: 1px solid rgba(113, 203, 255, 0.2) !important;
    padding: 0.15rem 0.5rem !important;
    border-radius: 10px !important;
