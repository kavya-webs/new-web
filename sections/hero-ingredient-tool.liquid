{% schema %}
{
  "name": "Ingredient Tool Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find Your Exact Skincare Chemistry."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Tell us your skin type and concern, and our clinical algorithm will recommend the exact ingredients, amounts, and routine you need."
    }
  ],
  "presets": [
    {
      "name": "Ingredient Tool Hero"
    }
  ]
}
{% endschema %}

{{ 'component-cart-drawer.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

<style>
  .hero-tool-section {
    background: linear-gradient(135deg, #091c2b 0%, #123b5a 100%);
    color: #ffffff;
    padding: 6rem 2rem;
    min-height: 80vh;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
  }
  
  .hero-tool-bg-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 60vw;
    height: 60vw;
    background: radial-gradient(circle, rgba(113, 203, 255, 0.15) 0%, rgba(18, 59, 90, 0) 70%);
    z-index: 1;
    pointer-events: none;
  }

  .hero-tool-container {
    max-width: 1000px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 3rem;
    width: 100%;
  }

  .hero-tool-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto;
  }

  .hero-tool-header h1 {
    font-size: 3.5rem;
    font-family: 'Outfit', sans-serif;
    font-weight: 600;
    line-height: 1.1;
    margin-bottom: 1rem;
    color: #ffffff;
  }

  .hero-tool-header p {
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.6;
  }

  .hero-tool-interface {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 24px;
    padding: 3rem;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow: 0 30px 60px rgba(0,0,0,0.2);
    transition: all 0.4s ease;
  }

  .tool-step {
    display: none;
    animation: fadeIn 0.4s ease forwards;
  }

  .tool-step.active {
    display: block;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .tool-question {
    font-size: 1.8rem;
    font-family: 'Outfit', sans-serif;
    font-weight: 500;
    margin-bottom: 2rem;
    text-align: center;
    color: #ffffff;
  }

  .options-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
  }

  .option-btn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #fff;
    padding: 1.2rem;
    border-radius: 12px;
    font-family: 'Inter', sans-serif;
    font-size: 1.1rem;
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .option-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    transform: translateY(-2px);
    border-color: rgba(255, 255, 255, 0.3);
  }

  .option-btn.selected {
    background: #ffffff;
    color: #123b5a;
    border-color: #ffffff;
    font-weight: 600;
  }

  .tool-controls {
    display: flex;
    justify-content: space-between;
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255,255,255,0.1);
  }

  .btn-tool {
    padding: 0.8rem 2rem;
    border-radius: 30px;
    font-family: 'Inter', sans-serif;
    font-weight: 500;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.2s ease;
    border: none;
  }

  .btn-prev {
    background: transparent;
    color: rgba(255,255,255,0.7);
  }
  .btn-prev:hover {
    color: #fff;
  }

  .btn-next {
    background: #ffffff;
    color: #123b5a;
  }
  .btn-next:hover {
    background: #e2e2e2;
    transform: scale(1.05);
  }
  .btn-next:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
  }

  /* Results Styling */
  .results-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }
  .results-header h2 {
    font-family: 'Outfit', sans-serif;
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
    color: #ffffff;
  }
  .results-header p {
    color: rgba(255,255,255,0.8);
  }

  .routine-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }
  
  .routine-time-block {
    background: rgba(0, 0, 0, 0.2);
    border-radius: 16px;
    padding: 2rem;
  }

  .routine-time-block h3 {
    font-family: 'Outfit', sans-serif;
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border-bottom: 1px solid rgba(255,255,255,0.1);
    padding-bottom: 0.8rem;
    color: #ffffff;
  }

  .ingredient-item {
    margin-bottom: 1.5rem;
  }
  
  .ingredient-name {
    font-weight: 600;
    font-size: 1.1rem;
    margin-bottom: 0.3rem;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  
  .ingredient-amount {
    font-size: 0.85rem;
    background: rgba(255,255,255,0.15);
    padding: 0.2rem 0.6rem;
    border-radius: 12px;
  }

  .ingredient-why {
    font-size: 0.9rem;
    color: rgba(255,255,255,0.7);
    line-height: 1.4;
    margin-bottom: 0.8rem;
  }

  .product-match {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 8px;
    padding: 0.8rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .product-match-info strong {
    display: block;
    font-size: 0.95rem;
    color: #fff;
  }
  
  .product-match-info span {
    font-size: 0.8rem;
    color: rgba(255,255,255,0.6);
  }

  .btn-add-cart {
    background: #fff;
    color: #123b5a;
    border: none;
    padding: 0.4rem 1rem;
    border-radius: 16px;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
  }
  .btn-add-cart:hover {
    background: #f0f0f0;
    transform: scale(1.05);
  }

  .not-sold-badge {
    font-size: 0.8rem;
    color: #ffa8a8;
    background: rgba(255, 168, 168, 0.1);
    padding: 0.4rem 0.8rem;
    border-radius: 16px;
    display: inline-block;
  }

  .action-buttons {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-top: 3rem;
  }
  .btn-outline {
    background: transparent;
    border: 1px solid rgba(255,255,255,0.3);
    color: #fff;
  }
  .btn-outline:hover {
    background: rgba(255,255,255,0.1);
  }

  @media (max-width: 768px) {
    .hero-tool-section {
      padding: 3rem 1rem;
      min-height: auto;
    }
    .routine-split {
      grid-template-columns: 1fr;
    }
    .hero-tool-header h1 {
      font-size: 2.5rem;
    }
    .hero-tool-interface {
      padding: 1.5rem;
    }
    .option-btn {
      padding: 0.8rem;
      font-size: 1rem;
    }
    .tool-question {
      font-size: 1.5rem;
      margin-bottom: 1.5rem;
    }
  }
</style>

<section class="hero-tool-section">
  <div class="hero-tool-bg-glow"></div>
  <div class="hero-tool-container">
    
    <div class="hero-tool-header">
      <h1>{{ section.settings.heading }}</h1>
      <p>{{ section.settings.subheading }}</p>
    </div>

    <div class="hero-tool-interface" id="ingredient-tool">
      
      <!-- Step 1: Skin Type -->
      <div class="tool-step active" data-step="1">
        <h2 class="tool-question">1. What is your primary skin type?</h2>
        <div class="options-grid">
          <button class="option-btn" data-value="oily">Oily</button>
          <button class="option-btn" data-value="dry">Dry</button>
          <button class="option-btn" data-value="combination">Combination</button>
          <button class="option-btn" data-value="sensitive">Sensitive</button>
        </div>
        <div class="tool-controls">
          <div></div> <!-- spacer -->
          <button class="btn-tool btn-next" disabled>Next Step →</button>
        </div>
      </div>

      <!-- Step 2: Concern -->
      <div class="tool-step" data-step="2">
        <h2 class="tool-question">2. What is your main skin concern?</h2>
        <div class="options-grid">
          <button class="option-btn" data-value="acne">Acne & Breakouts</button>
          <button class="option-btn" data-value="dullness">Dullness & Pigmentation</button>
          <button class="option-btn" data-value="aging">Fine Lines & Aging</button>
          <button class="option-btn" data-value="barrier">Redness & Damaged Barrier</button>
        </div>
        <div class="tool-controls">
          <button class="btn-tool btn-prev">← Back</button>
          <button class="btn-tool btn-next" disabled>Analyze My Skin →</button>
        </div>
      </div>

      <!-- Step 3: Loading -->
      <div class="tool-step" data-step="3" id="loading-step" style="text-align:center; padding: 4rem 0;">
        <svg style="animation: spin 1s linear infinite; margin-bottom: 1rem;" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg>
        <h2 class="tool-question">Formulating your clinical routine...</h2>
        <style>@keyframes spin { 100% { transform: rotate(360deg); } }</style>
      </div>

      <!-- Step 4: Results -->
      <div class="tool-step" data-step="4" id="results-step">
        <div class="results-header">
          <h2>Your Skincare Plan</h2>
          <p id="results-subtitle">Based on your answers, here is the clinical breakdown.</p>
        </div>
        
        <div class="routine-split">
          <div class="routine-time-block">
            <h3>☀️ Morning Routine (AM)</h3>
            <div id="am-routine-container"></div>
          </div>
          <div class="routine-time-block">
            <h3>🌙 Evening Routine (PM)</h3>
            <div id="pm-routine-container"></div>
          </div>
        </div>

        <div class="action-buttons">
          <button class="btn-tool btn-outline btn-retake">↻ Retake Analysis</button>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Product Data Mapping -->
<script>
  window.SeravolveProducts = {
    'facewash': {
      title: '2% Salicylic Acid Facewash',
      variantId: '49632340279448',
      price: '₹349'
    },
    'toner': {
      title: '3% Niacinamide & Rice Water Toner',
      variantId: '49632340344984',
      price: '₹399'
    },
    'vitc': {
      title: '10% Vitamin C Face Serum',
      variantId: '49632340410520',
      price: '₹599'
    },
    'moisturiser': {
      title: 'Barrier Repair Moisturiser',
      variantId: '49632340443288',
      price: '₹449'
    },
    'sunscreen': {
      title: 'Sunscreen Fluid SPF 50+',
      variantId: '49632340508824',
      price: '₹499'
    }
  };

  const ingredientMatrix = {
    // ---- ACNE CONCERN ----
    acne: {
      am: [
        { name: "Salicylic Acid (BHA)", amount: "2%", why: "Cuts through humid-weather sebum to keep pores clear all day.", product: "facewash" },
        { name: "Niacinamide", amount: "3-5%", why: "Controls oil and stops post-acne dark spots on melanin-rich skin.", product: "toner" },
        { name: "Broad Spectrum SPF", amount: "SPF 50+", why: "Crucial to prevent acne marks from permanently darkening in the Indian sun.", product: "sunscreen" }
      ],
      pm: [
        { name: "Salicylic Acid (BHA)", amount: "2%", why: "Deep cleanses accumulated daily sweat, pollution, and oil.", product: "facewash" },
        { name: "Benzoyl Peroxide / Azelaic Acid", amount: "2.5-5%", why: "Kills acne bacteria and fades dark marks. (Start slow).", product: null },
        { name: "Ceramides", amount: "Multi-complex", why: "Repairs the skin barrier without feeling greasy in hot weather.", product: "moisturiser" }
      ]
    },
    // ---- DULLNESS & PIGMENTATION ----
    dullness: {
      am: [
        { name: "Vitamin C (Ethyl Ascorbic Acid)", amount: "10%", why: "Highly stable in Indian heat; powerful antioxidant that brightens pigmentation.", product: "vitc" },
        { name: "Niacinamide", amount: "3%", why: "Blocks melanin transfer to prevent new dark spots from forming.", product: "toner" },
        { name: "Broad Spectrum SPF", amount: "SPF 50+", why: "UV exposure is the #1 cause of pigmentation in Indian skin. Non-negotiable.", product: "sunscreen" }
      ],
      pm: [
        { name: "Gentle Surfactants", amount: "Balanced", why: "Cleanses without stripping lipids, preventing irritation-induced pigmentation.", product: "facewash" },
        { name: "Alpha Arbutin / Glycolic Acid", amount: "2-5%", why: "Dermatologist-favorite for fading stubborn PIH. Use 2x a week.", product: null },
        { name: "Hyaluronic Acid + Ceramides", amount: "Optimal", why: "Plumps skin by effortlessly drawing moisture from humid air.", product: "moisturiser" }
      ]
    },
    // ---- AGING & FINE LINES ----
    aging: {
      am: [
        { name: "Vitamin C", amount: "10%", why: "Fights free radicals from high city pollution and stimulates collagen.", product: "vitc" },
        { name: "Broad Spectrum SPF", amount: "SPF 50+", why: "Prevents 90% of premature aging caused by harsh UVA/UVB rays.", product: "sunscreen" }
      ],
      pm: [
        { name: "Gentle Cleanser", amount: "Balanced", why: "Preps the skin for active treatments without causing dryness.", product: "facewash" },
        { name: "Retinol / Retinoid", amount: "0.1-0.3%", why: "Gold standard for cell turnover. Use the sandwich method to avoid PIH.", product: null },
        { name: "Ceramides & Peptides", amount: "Multi-complex", why: "Counters retinol irritation and supports the skin structure.", product: "moisturiser" }
      ]
    },
    // ---- BARRIER & SENSITIVE ----
    barrier: {
      am: [
        { name: "Rice Water Ferment", amount: "Extract", why: "Soothes inflammation and provides lightweight, non-sticky hydration.", product: "toner" },
        { name: "Ceramides", amount: "Multi-complex", why: "Rebuilds lipid barrier frequently damaged by hard water and pollution.", product: "moisturiser" },
        { name: "Physical/Hybrid SPF", amount: "SPF 50+", why: "Shields compromised skin from intense UV and environmental stressors.", product: "sunscreen" }
      ],
      pm: [
        { name: "Sulfate-Free Cleanser", amount: "Gentle", why: "Ultra-gentle wash that won't disrupt the delicate acid mantle.", product: "facewash" },
        { name: "Centella Asiatica (Cica)", amount: "Extract", why: "Clinically proven to accelerate barrier healing and reduce redness.", product: "vitc" },
        { name: "Ceramides + Squalane", amount: "Optimal", why: "Mimics natural skin lipids for deep overnight repair without heaviness.", product: "moisturiser" }
      ]
    }
  };

  document.addEventListener('DOMContentLoaded', () => {
    let currentStep = 1;
    const selections = { type: null, concern: null };

    // Handle Option Selection
    document.querySelectorAll('.option-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const stepDiv = e.target.closest('.tool-step');
        const stepNum = parseInt(stepDiv.dataset.step);
        
        // Remove selected from siblings
        stepDiv.querySelectorAll('.option-btn').forEach(b => b.classList.remove('selected'));
        // Add selected to clicked
        e.currentTarget.classList.add('selected');
        
        // Enable next button
        stepDiv.querySelector('.btn-next').disabled = false;
        
        // Save selection
        if(stepNum === 1) selections.type = e.currentTarget.dataset.value;
        if(stepNum === 2) selections.concern = e.currentTarget.dataset.value;
      });
    });

    // Handle Next
    document.querySelectorAll('.btn-next').forEach(btn => {
      btn.addEventListener('click', () => {
        if(currentStep === 2) {
          goToStep(3); // Loading
          setTimeout(() => generateResults(), 1500); // Fake load time
        } else {
          goToStep(currentStep + 1);
        }
      });
    });

    // Handle Prev
    document.querySelectorAll('.btn-prev').forEach(btn => {
      btn.addEventListener('click', () => goToStep(currentStep - 1));
    });

    // Handle Retake
    document.querySelector('.btn-retake').addEventListener('click', () => {
      document.querySelectorAll('.option-btn').forEach(b => b.classList.remove('selected'));
      document.querySelectorAll('.btn-next').forEach(b => b.disabled = true);
      selections.type = null;
      selections.concern = null;
      goToStep(1);
    });

    function goToStep(step) {
      document.querySelectorAll('.tool-step').forEach(el => el.classList.remove('active'));
      document.querySelector(`.tool-step[data-step="${step}"]`).classList.add('active');
      currentStep = step;
    }

    function generateResults() {
      const routine = ingredientMatrix[selections.concern];
      document.getElementById('results-subtitle').innerText = `Recommendation for: ${capitalize(selections.type)} skin prone to ${capitalize(selections.concern)}`;
      
      renderRoutine('am', routine.am);
      renderRoutine('pm', routine.pm);
      
      goToStep(4);
    }

    function renderRoutine(time, ingredients) {
      const container = document.getElementById(`${time}-routine-container`);
      container.innerHTML = '';

      ingredients.forEach(ing => {
        let actionHtml = '';
        if (ing.product && window.SeravolveProducts[ing.product]) {
          const prod = window.SeravolveProducts[ing.product];
          actionHtml = `
            <div class="product-match">
              <div class="product-match-info">
                <strong>Found in: ${prod.title}</strong>
              </div>
              <button class="btn-add-cart" onclick="addToCart('${prod.variantId}', this)">Add to Cart</button>
            </div>
          `;
        } else {
          actionHtml = `
            <div class="not-sold-badge">Highly recommended, but not currently sold by Seravolve.</div>
          `;
        }

        const html = `
          <div class="ingredient-item">
            <div class="ingredient-name">
              ${ing.name} <span class="ingredient-amount">${ing.amount}</span>
            </div>
            <div class="ingredient-why">${ing.why}</div>
            ${actionHtml}
          </div>
        `;
        container.insertAdjacentHTML('beforeend', html);
      });
    }

    function capitalize(s) {
      return s.charAt(0).toUpperCase() + s.slice(1);
    }
  });

  // Global Cart Add Function leveraging Shopify AJAX API
  window.addToCart = function(variantId, btnElement) {
    const originalText = btnElement.innerText;
    btnElement.innerText = "Adding...";
    btnElement.disabled = true;

    let formData = {
      'items': [{ 'id': parseInt(variantId), 'quantity': 1 }]
    };

    fetch(window.Shopify.routes.root + 'cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(formData)
    })
    .then(response => response.json())
    .then(data => {
      btnElement.innerText = "Added!";
      btnElement.style.background = "#4CAF50";
      btnElement.style.color = "#fff";
      
      // Trigger theme cart drawer if it exists
      if (document.querySelector('cart-drawer')) {
         document.querySelector('cart-drawer').classList.add('active');
         // Or standard Shopify custom event
         document.dispatchEvent(new CustomEvent('cart:build'));
         document.dispatchEvent(new CustomEvent('cart:refresh'));
      }
      
      setTimeout(() => {
        btnElement.innerText = originalText;
        btnElement.style.background = "#fff";
        btnElement.style.color = "#123b5a";
        btnElement.disabled = false;
      }, 2000);
    })
    .catch((error) => {
      console.error('Error:', error);
      btnElement.innerText = "Error";
    });
  };
</script>
