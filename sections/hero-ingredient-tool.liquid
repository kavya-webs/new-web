  }

  .hero-tool-section .hero-tool-card:hover {
    background: linear-gradient(145deg, rgba(24, 76, 115, 0.85) 0%, rgba(12, 38, 58, 0.95) 100%) !important;
    border-color: rgba(113, 203, 255, 0.35) !important;
  }

  .hero-tool-section .hero-tool-card-top {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.35rem;
    flex-wrap: wrap;
  }

  .hero-tool-section .hero-tool-step-badge {
    background: rgba(113, 203, 255, 0.18) !important;
    color: #71cbff !important;
    font-size: 0.72rem !important;
    font-weight: 700 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.05em !important;
    padding: 0.2rem 0.5rem !important;
    border-radius: 6px !important;
