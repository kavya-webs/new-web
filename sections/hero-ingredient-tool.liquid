  }

  /* Ayurvedic Boost Sub-section */
  .hero-tool-section .hero-tool-boost {
    background: rgba(74, 222, 128, 0.08) !important;
    border: 1px solid rgba(74, 222, 128, 0.18) !important;
    border-radius: 8px !important;
    padding: 0.45rem 0.65rem !important;
    margin-bottom: 0.5rem !important;
    display: flex;
    align-items: flex-start;
    gap: 0.4rem;
  }
  .hero-tool-section .hero-tool-boost-icon {
    font-size: 0.85rem;
    flex-shrink: 0;
    line-height: 1.3;
  }
  .hero-tool-section .hero-tool-boost-content {
    flex: 1;
    min-width: 0;
  }
  .hero-tool-section .hero-tool-boost-name {
    font-weight: 600 !important;
    font-size: 0.82rem !important;
    color: #86efac !important;
  }
  .hero-tool-section .hero-tool-boost-why {
    font-size: 0.78rem !important;
    color: rgba(255,255,255,0.65) !important;
    line-height: 1.35 !important;
    margin-top: 0.1rem;
  }

  .hero-tool-section .hero-tool-product-pill {
    background: rgba(0, 0, 0, 0.35) !important;
    border: 1px solid rgba(255, 255, 255, 0.12) !important;
    border-radius: 8px !important;
    padding: 0.45rem 0.75rem !important;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .hero-tool-section .hero-tool-prod-info {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    overflow: hidden;
    font-size: 0.84rem !important;
    color: #ffffff !important;
    min-width: 0;
  }

  .hero-tool-section .hero-tool-brand-dot {
    width: 6px;
    height: 6px;
    background: #71cbff !important;
    border-radius: 50% !important;
    flex-shrink: 0;
  }

  .hero-tool-section .hero-tool-prod-title {
    font-weight: 500 !important;
    color: #ffffff !important;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .hero-tool-section .hero-tool-prod-price {
    color: #71cbff !important;
    font-weight: 600 !important;
    font-size: 0.82rem !important;
    flex-shrink: 0;
  }

  .hero-tool-section .hero-tool-add-btn {
    background: #ffffff !important;
    color: #123b5a !important;
    border: none !important;
    padding: 0.32rem 0.8rem !important;
    border-radius: 14px !important;
    font-size: 0.8rem !important;
    font-weight: 600 !important;
    cursor: pointer;
    flex-shrink: 0;
    transition: all 0.2s ease !important;
  }

  .hero-tool-section .hero-tool-add-btn:hover {
    background: #e5f4ff !important;
    transform: scale(1.04);
  }

  .hero-tool-section .hero-tool-not-sold-pill {
    background: rgba(255, 180, 100, 0.12) !important;
    border: 1px solid rgba(255, 180, 100, 0.25) !important;
    border-radius: 8px !important;
    padding: 0.4rem 0.7rem !important;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem !important;
    color: #fed7aa !important;
  }

  .hero-tool-section .hero-tool-not-sold-icon {
    font-size: 0.85rem;
    flex-shrink: 0;
  }

  .action-buttons {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-top: 2rem;
  }
  .btn-outline {
    background: transparent;
    border: 1px solid rgba(255,255,255,0.3);
    color: #fff;
  }
  .btn-outline:hover {
    background: rgba(255,255,255,0.1);
  }

  /* Disclaimer */
  .hero-tool-disclaimer {
    text-align: center;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255,255,255,0.08);
    font-size: 0.72rem;
    color: rgba(255,255,255,0.4);
    line-height: 1.5;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  @media (min-width: 769px) {
    .routine-time-block {
      display: block !important;
    }
  }

  @media (max-width: 768px) {
    .hero-tool-section {
      padding: 2rem 0.75rem;
      min-height: auto;
    }
    .hero-tool-container {
      gap: 1.5rem;
    }
    .hero-tool-header h1 {
      font-size: 1.85rem;
      line-height: 1.15;
      margin-bottom: 0.5rem;
    }
    .hero-tool-header p {
      font-size: 0.9rem;
      line-height: 1.45;
    }
    .hero-tool-interface {
      padding: 1.1rem 0.85rem;
      border-radius: 16px;
    }
    .tool-question {
      font-size: 1.25rem;
      margin-bottom: 1rem;
    }
    .options-grid {
      grid-template-columns: 1fr 1fr;
      gap: 0.6rem;
    }
    .option-btn {
      padding: 0.75rem 0.5rem;
      font-size: 0.92rem;
      border-radius: 10px;
    }
    .option-btn .option-sub {
      font-size: 0.7rem;
    }
    .tool-controls {
      margin-top: 1.25rem;
      padding-top: 1rem;
    }
    .btn-tool {
      padding: 0.65rem 1.4rem;
      font-size: 0.9rem;
    }

    /* Results Step on Mobile */
    .results-header {
      margin-bottom: 1.2rem;
    }
    .results-header h2 {
      font-size: 1.6rem;
      margin-bottom: 0.25rem;
    }
    .results-header p {
      font-size: 0.85rem;
      line-height: 1.35;
    }

    .routine-tabs {
      display: flex; /* Mobile tab pill bar */
    }

    .routine-split {
      display: block;
    }

    .routine-time-block {
      display: none;
      background: transparent;
      padding: 0;
      border-radius: 0;
    }

    .routine-time-block.active {
      display: block;
      animation: fadeIn 0.25s ease;
    }

    .routine-time-heading {
      display: none; /* Tabs already label AM and PM */
    }

    .action-buttons {
      margin-top: 1.25rem;
    }

    .btn-outline {
      padding: 0.55rem 1.3rem;
      font-size: 0.82rem;
    }
  }
</style>

<section class="hero-tool-section" id="ingredient-tool-section">
  <div class="hero-tool-bg-glow"></div>
  <div class="hero-tool-container">
    
    <div class="hero-tool-header">
      <h1>{{ section.settings.heading }}</h1>
      <p>{{ section.settings.subheading }}</p>
    </div>

    <div class="hero-tool-interface" id="ingredient-tool">
      
      <!-- Progress Dots -->
      <div class="tool-progress" id="tool-progress">
        <div class="tool-progress-dot active" data-dot="1"></div>
        <div class="tool-progress-dot" data-dot="2"></div>
        <div class="tool-progress-dot" data-dot="3"></div>
      </div>

      <!-- Step 1: Skin Type -->
      <div class="tool-step active" data-step="1">
        <h2 class="tool-question">1. What is your primary skin type?</h2>
        <div class="options-grid">
          <button class="option-btn" data-value="oily">Oily</button>
          <button class="option-btn" data-value="dry">Dry</button>
          <button class="option-btn" data-value="combination">Combination</button>
          <button class="option-btn" data-value="sensitive">Sensitive</button>
        </div>
        <div class="tool-controls">
          <div></div> <!-- spacer -->
          <button class="btn-tool btn-next" disabled>Next Step →</button>
        </div>
      </div>

      <!-- Step 2: Concern -->
      <div class="tool-step" data-step="2">
        <h2 class="tool-question">2. What is your main skin concern?</h2>
        <div class="options-grid">
          <button class="option-btn" data-value="acne">Acne & Breakouts</button>
          <button class="option-btn" data-value="dullness">Dullness & Pigmentation</button>
          <button class="option-btn" data-value="aging">Fine Lines & Aging</button>
          <button class="option-btn" data-value="barrier">Redness & Damaged Barrier</button>
        </div>
        <div class="tool-controls">
          <button class="btn-tool btn-prev">← Back</button>
          <button class="btn-tool btn-next" disabled>Next Step →</button>
        </div>
      </div>

      <!-- Step 3: Season -->
      <div class="tool-step" data-step="3">
        <h2 class="tool-question">3. What season is it where you are?</h2>
        <div class="options-grid" id="season-options">
          <button class="option-btn" data-value="summer">
            <span class="option-emoji">☀️</span>
            Summer
            <span class="option-sub">Mar – Jun</span>
          </button>
          <button class="option-btn" data-value="monsoon">
            <span class="option-emoji">🌧️</span>
            Monsoon
            <span class="option-sub">Jul – Sep</span>
          </button>
          <button class="option-btn" data-value="winter">
            <span class="option-emoji">❄️</span>
            Winter
            <span class="option-sub">Oct – Feb</span>
          </button>
        </div>
        <div class="tool-controls">
          <button class="btn-tool btn-prev">← Back</button>
          <button class="btn-tool btn-next" disabled>Analyze My Skin →</button>
        </div>
      </div>

      <!-- Step 4: Loading -->
      <div class="tool-step" data-step="4" id="loading-step" style="text-align:center; padding: 4rem 0;">
        <svg style="animation: spin 1s linear infinite; margin-bottom: 1rem;" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg>
        <h2 class="tool-question">Formulating your seasonal routine...</h2>
        <style>@keyframes spin { 100% { transform: rotate(360deg); } }</style>
      </div>

      <!-- Step 5: Results -->
      <div class="tool-step" data-step="5" id="results-step">
        <div class="results-header">
          <h2>Your Skincare Plan</h2>
          <p id="results-subtitle">Based on your answers, here is your personalized breakdown.</p>
          <div class="results-season-badge" id="results-season-badge"></div>
        </div>
        
        <!-- Mobile AM/PM Tab Toggle -->
        <div class="routine-tabs" role="tablist">
          <button type="button" class="routine-tab-btn active" data-tab="am" role="tab" aria-selected="true">☀️ Morning (AM)</button>
          <button type="button" class="routine-tab-btn" data-tab="pm" role="tab" aria-selected="false">🌙 Evening (PM)</button>
        </div>

        <div class="routine-split">
          <div class="routine-time-block active" id="am-time-block">
            <h3 class="routine-time-heading">☀️ Morning Routine (AM)</h3>
            <div id="am-routine-container" class="hero-tool-cards-list"></div>
          </div>
          <div class="routine-time-block" id="pm-time-block">
            <h3 class="routine-time-heading">🌙 Evening Routine (PM)</h3>
            <div id="pm-routine-container" class="hero-tool-cards-list"></div>
          </div>
        </div>

        <div class="hero-tool-disclaimer">
          🌿 Ayurvedic suggestions are based on traditional wisdom supported by modern research. Individual results may vary. For persistent concerns, please consult a dermatologist.
        </div>

        <div class="action-buttons">
          <button class="btn-tool btn-outline btn-retake">↻ Retake Analysis</button>
        </div>
      </div>

    </div>
  </div>
</section>

