  /* ============================================================
     AUTO-DETECT INDIAN SEASON
     ============================================================ */
  function detectSeason() {
    const month = new Date().getMonth(); // 0-indexed (0=Jan)
    if (month >= 2 && month <= 5) return 'summer';   // Mar–Jun
    if (month >= 6 && month <= 8) return 'monsoon';   // Jul–Sep
    return 'winter';                                    // Oct–Feb
  }

  const seasonLabels = {
    summer: '☀️ Summer Routine (Mar–Jun)',
    monsoon: '🌧️ Monsoon Routine (Jul–Sep)',
    winter: '❄️ Winter Routine (Oct–Feb)'
  };

  document.addEventListener('DOMContentLoaded', () => {
    let currentStep = 1;
    const selections = { type: null, concern: null, season: null };

    // Auto-detect and pre-select season
    const autoSeason = detectSeason();
    const seasonBtns = document.querySelectorAll('#season-options .option-btn');
    seasonBtns.forEach(btn => {
      if (btn.dataset.value === autoSeason) {
        btn.classList.add('selected');
        selections.season = autoSeason;
        // Add "Auto-detected" badge
        const badge = document.createElement('span');
        badge.className = 'season-auto-badge';
        badge.textContent = '✓ Current';
        btn.appendChild(badge);
        // Enable next button for step 3
        const step3 = document.querySelector('.tool-step[data-step="3"]');
        if (step3) step3.querySelector('.btn-next').disabled = false;
      }
    });

    // Handle Option Selection
    document.querySelectorAll('.option-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const stepDiv = e.target.closest('.tool-step');
        if (!stepDiv) return;
        const stepNum = parseInt(stepDiv.dataset.step);
        
        // Remove selected from siblings
        stepDiv.querySelectorAll('.option-btn').forEach(b => b.classList.remove('selected'));
        // Remove auto-badge if exists
        stepDiv.querySelectorAll('.season-auto-badge').forEach(b => b.remove());
        // Add selected to clicked
        e.currentTarget.classList.add('selected');
        
        // Enable next button
        stepDiv.querySelector('.btn-next').disabled = false;
        
        // Save selection
        if(stepNum === 1) selections.type = e.currentTarget.dataset.value;
        if(stepNum === 2) selections.concern = e.currentTarget.dataset.value;
        if(stepNum === 3) selections.season = e.currentTarget.dataset.value;
      });
    });

    // Handle Next
    document.querySelectorAll('.btn-next').forEach(btn => {
      btn.addEventListener('click', () => {
        if(currentStep === 3) {
          goToStep(4); // Loading
          setTimeout(() => generateResults(), 1500);
        } else {
          goToStep(currentStep + 1);
        }
      });
    });

    // Handle Prev
    document.querySelectorAll('.btn-prev').forEach(btn => {
      btn.addEventListener('click', () => goToStep(currentStep - 1));
    });

    // Handle Retake
    document.querySelector('.btn-retake').addEventListener('click', () => {
      document.querySelectorAll('.option-btn').forEach(b => b.classList.remove('selected'));
      document.querySelectorAll('.btn-next').forEach(b => b.disabled = true);
      document.querySelectorAll('.season-auto-badge').forEach(b => b.remove());
      selections.type = null;
      selections.concern = null;
      selections.season = null;

      // Re-auto-detect season
      const freshSeason = detectSeason();
      seasonBtns.forEach(btn => {
        if (btn.dataset.value === freshSeason) {
          btn.classList.add('selected');
          selections.season = freshSeason;
          const badge = document.createElement('span');
          badge.className = 'season-auto-badge';
          badge.textContent = '✓ Current';
          btn.appendChild(badge);
          const step3 = document.querySelector('.tool-step[data-step="3"]');
          if (step3) step3.querySelector('.btn-next').disabled = false;
        }
      });

      goToStep(1);
    });

    function goToStep(step) {
      document.querySelectorAll('.tool-step').forEach(el => el.classList.remove('active'));
      document.querySelector(`.tool-step[data-step="${step}"]`).classList.add('active');
      currentStep = step;
      updateProgress(step);
    }

    function updateProgress(step) {
      const dots = document.querySelectorAll('.tool-progress-dot');
      dots.forEach((dot, idx) => {
        const dotStep = idx + 1;
        dot.classList.remove('active', 'done');
        if (step >= 4) {
          // Results: all done
          dot.classList.add('done');
        } else if (dotStep === step) {
          dot.classList.add('active');
        } else if (dotStep < step) {
          dot.classList.add('done');
        }
      });
    }

    // Handle Routine Tabs
    document.querySelectorAll('.routine-tab-btn').forEach(tabBtn => {
      tabBtn.addEventListener('click', (e) => {
        const targetTab = e.currentTarget.dataset.tab;
        document.querySelectorAll('.routine-tab-btn').forEach(b => {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        e.currentTarget.classList.add('active');
        e.currentTarget.setAttribute('aria-selected', 'true');

        document.querySelectorAll('.routine-time-block').forEach(block => {
          block.classList.remove('active');
        });
        const activeBlock = document.getElementById(`${targetTab}-time-block`);
        if (activeBlock) {
          activeBlock.classList.add('active');
        }
      });
    });

    function generateResults() {
      const routine = ingredientMatrix[selections.concern][selections.season];
      document.getElementById('results-subtitle').innerText = `Recommendation for: ${capitalize(selections.type)} skin prone to ${capitalize(selections.concern)}`;
      document.getElementById('results-season-badge').innerHTML = seasonLabels[selections.season];
      
      // Reset to AM tab
      document.querySelectorAll('.routine-tab-btn').forEach(b => {
        b.classList.toggle('active', b.dataset.tab === 'am');
        b.setAttribute('aria-selected', b.dataset.tab === 'am' ? 'true' : 'false');
      });
      const amBlock = document.getElementById('am-time-block');
      const pmBlock = document.getElementById('pm-time-block');
      if (amBlock) amBlock.classList.add('active');
      if (pmBlock) pmBlock.classList.remove('active');

      renderRoutine('am', routine.am);
      renderRoutine('pm', routine.pm);
      
      goToStep(5);
    }

    function renderRoutine(time, ingredients) {
      const container = document.getElementById(`${time}-routine-container`);
      container.innerHTML = '';

      ingredients.forEach((ing, idx) => {
        let boostHtml = '';
        if (ing.boost) {
          boostHtml = `
            <div class="hero-tool-boost">
              <span class="hero-tool-boost-icon">🌿</span>
              <div class="hero-tool-boost-content">
                <span class="hero-tool-boost-name">${ing.boost.name}</span>
                <div class="hero-tool-boost-why">${ing.boost.why}</div>
              </div>
            </div>
          `;
        }

        let actionHtml = '';
        if (ing.product && window.SeravolveProducts[ing.product]) {
          const prod = window.SeravolveProducts[ing.product];
          actionHtml = `
            <div class="hero-tool-product-pill">
              <div class="hero-tool-prod-info">
                <span class="hero-tool-brand-dot"></span>
                <span class="hero-tool-prod-title">${prod.title}</span>
                <span class="hero-tool-prod-price">${prod.price}</span>
              </div>
              <button type="button" class="hero-tool-add-btn" onclick="addToCart('${prod.variantId}', this)">+ Add</button>
            </div>
          `;
        } else {
          actionHtml = `
            <div class="hero-tool-not-sold-pill">
              <span class="hero-tool-not-sold-icon">💡</span>
              <span class="hero-tool-not-sold-text">Not sold by Seravolve (Use a trusted pharmacy brand)</span>
            </div>
          `;
        }

        const html = `
          <div class="hero-tool-card">
            <div class="hero-tool-card-top">
              <span class="hero-tool-step-badge">Step ${idx + 1}</span>
              <span class="hero-tool-ing-name">${ing.name}</span>
              <span class="hero-tool-ing-amount">${ing.amount}</span>
            </div>
            <p class="hero-tool-why-text">${ing.why}</p>
            ${boostHtml}
            ${actionHtml}
          </div>
        `;
        container.insertAdjacentHTML('beforeend', html);
      });
    }

    function capitalize(s) {
      return s.charAt(0).toUpperCase() + s.slice(1);
    }
  });

  // Global Cart Add Function leveraging Shopify AJAX API
  window.addToCart = function(variantId, btnElement) {
    const originalText = btnElement.innerText;
    btnElement.innerText = "Adding...";
    btnElement.disabled = true;

    let formData = {
      'items': [{ 'id': parseInt(variantId), 'quantity': 1 }]
    };

    fetch(window.Shopify.routes.root + 'cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(formData)
    })
    .then(response => response.json())
    .then(data => {
      btnElement.innerText = "Added!";
      btnElement.style.background = "#4CAF50";
      btnElement.style.color = "#fff";
      
      // Trigger theme cart drawer if it exists
      if (document.querySelector('cart-drawer')) {
         document.querySelector('cart-drawer').classList.add('active');
         // Or standard Shopify custom event
         document.dispatchEvent(new CustomEvent('cart:build'));
         document.dispatchEvent(new CustomEvent('cart:refresh'));
      }
      
      setTimeout(() => {
        btnElement.innerText = originalText;
        btnElement.style.background = "#fff";
        btnElement.style.color = "#123b5a";
        btnElement.disabled = false;
      }, 2000);
    })
    .catch((error) => {
      console.error('Error:', error);
      btnElement.innerText = "Error";
    });
  };
</script>
